{
  "meta": {
    "name": "规则注册表-指南驱动-P0P1草案",
    "version": "draft-1",
    "encoding": "utf-8",
    "primary_source": "研究生学位论文写作指南（202503）.pdf",
    "goal": "将长篇核查方案收敛为可直接实现的规则注册表，仅保留 P0/P1 范围",
    "principles": [
      "指南正文是唯一一级规范来源",
      "DOCX 文本、DOCX XML、PDF 文本、PDF 可视化是四类并行证据",
      "P0 优先覆盖硬性格式要求，P1 覆盖高价值质量项",
      "凡遇表格、公式、图形、跨页断裂，允许抽取失败后回退到 PDF 视觉复核"
    ]
  },
  "data_contracts": [
    {
      "name": "guide_rules.json",
      "purpose": "保存指南规则本体",
      "required_fields": [
        "rule_id",
        "priority",
        "automation",
        "source_section",
        "source_pages",
        "requirement_summary",
        "evidence_types",
        "sop_refs"
      ]
    },
    {
      "name": "docx_logic.json",
      "purpose": "保存 DOCX 逻辑结构",
      "required_fields": [
        "paragraph_id",
        "section_id",
        "style_id",
        "style_name",
        "text",
        "text_norm",
        "has_drawing",
        "has_table",
        "has_omml",
        "field_type",
        "page_break_before"
      ]
    },
    {
      "name": "docx_layout.json",
      "purpose": "保存 DOCX 排版元数据",
      "required_fields": [
        "section_id",
        "page_width_cm",
        "page_height_cm",
        "margin_top_cm",
        "margin_bottom_cm",
        "margin_left_cm",
        "margin_right_cm",
        "header_distance_cm",
        "footer_distance_cm",
        "page_number_format",
        "page_number_start",
        "odd_even_headers",
        "style_effective"
      ]
    },
    {
      "name": "pdf_pages.json",
      "purpose": "保存 PDF 页面文本与坐标",
      "required_fields": [
        "page_no",
        "header_text",
        "footer_text",
        "possible_page_no",
        "text_blocks",
        "captions",
        "headings"
      ]
    },
    {
      "name": "visual_findings.json",
      "purpose": "保存 PDF 可视化复核结论",
      "required_fields": [
        "page_no",
        "rule_id",
        "screenshot",
        "note",
        "status"
      ]
    }
  ],
  "implementation_phases": [
    {
      "phase": "F0",
      "name": "规则库建立",
      "outputs": [
        "guide_rules.json"
      ],
      "gates": [
        "所有 P0/P1 规则都有稳定 rule_id",
        "所有规则都绑定 source_section 与 source_pages"
      ]
    },
    {
      "phase": "F1",
      "name": "证据抽取层",
      "outputs": [
        "docx_logic.json",
        "docx_layout.json",
        "pdf_pages.json"
      ],
      "gates": [
        "DOCX 段落、section、表格、脚注、标题链可稳定抽取",
        "PDF 页眉、页脚、题注、标题页首可稳定抽取"
      ]
    },
    {
      "phase": "F2",
      "name": "P0 规则判定层",
      "outputs": [
        "analysis_p0.json",
        "visual_findings.json"
      ],
      "gates": [
        "结构、摘要、页面、页码、正文样式、图表题注、文献核心规则可直接出结论"
      ]
    },
    {
      "phase": "F3",
      "name": "P1 规则扩展层",
      "outputs": [
        "analysis_p1.json"
      ],
      "gates": [
        "目录、名单、附录、脚注、单位、写作风险提示等规则进入统一报告"
      ]
    }
  ],
  "rules": [
    {
      "rule_id": "STR-01",
      "priority": "P0",
      "automation": "A",
      "title": "论文组成部分顺序",
      "source_section": "2.1",
      "source_pages": [
        8
      ],
      "requirement_summary": "必须按规定顺序包含中文封面、英文封面、名单、授权说明、摘要、Abstract、目录、正文、参考文献、致谢、声明等部分；可选部分按需出现。",
      "evidence_types": [
        "docx_text"
      ],
      "inputs": [
        "docx_logic.json"
      ],
      "check_points": [
        "必需部分是否全部存在",
        "顺序是否正确",
        "可选部分缺失不报错"
      ],
      "fail_severity": "high",
      "sop_refs": [
        "SOP-STR-01"
      ]
    },
    {
      "rule_id": "STR-02",
      "priority": "P0",
      "automation": "B",
      "title": "每部分独立成页",
      "source_section": "2.1",
      "source_pages": [
        8
      ],
      "requirement_summary": "每个部分从新的一页开始。",
      "evidence_types": [
        "docx_text",
        "docx_xml",
        "pdf_text"
      ],
      "inputs": [
        "docx_logic.json",
        "docx_layout.json",
        "pdf_pages.json"
      ],
      "check_points": [
        "部分标题前是否存在明确分页",
        "PDF 中部分标题是否位于新页页首"
      ],
      "fail_severity": "high",
      "sop_refs": [
        "SOP-STR-02"
      ]
    },
    {
      "rule_id": "STR-03",
      "priority": "P0",
      "automation": "A",
      "title": "全篇 A4 页面",
      "source_section": "2.2",
      "source_pages": [
        8,
        9
      ],
      "requirement_summary": "论文使用 A4 标准纸。",
      "evidence_types": [
        "docx_xml",
        "pdf_text"
      ],
      "inputs": [
        "docx_layout.json",
        "pdf_pages.json"
      ],
      "check_points": [
        "section 页尺寸是否为 A4",
        "PDF 页面框尺寸是否一致"
      ],
      "fail_severity": "high",
      "sop_refs": [
        "SOP-PAGE-01"
      ]
    },
    {
      "rule_id": "STR-04",
      "priority": "P0",
      "automation": "B",
      "title": "前四部分单面且无篇眉页码",
      "source_section": "2.2",
      "source_pages": [
        9
      ],
      "requirement_summary": "中文封面、英文封面、名单、授权说明单面印刷，不加篇眉和页码。",
      "evidence_types": [
        "docx_xml",
        "pdf_text",
        "pdf_visual"
      ],
      "inputs": [
        "docx_layout.json",
        "pdf_pages.json",
        "visual_findings.json"
      ],
      "check_points": [
        "前四部分无 header/footer 页码文本",
        "前四部分 section 行为与正文不同"
      ],
      "fail_severity": "high",
      "sop_refs": [
        "SOP-PAGE-02"
      ]
    },
    {
      "rule_id": "STR-05",
      "priority": "P0",
      "automation": "B",
      "title": "中文摘要开始双面并进入正式页眉页码体系",
      "source_section": "2.2",
      "source_pages": [
        9
      ],
      "requirement_summary": "从中文摘要开始双面印刷，并编写篇眉和页码。",
      "evidence_types": [
        "docx_xml",
        "pdf_text",
        "pdf_visual"
      ],
      "inputs": [
        "docx_layout.json",
        "pdf_pages.json",
        "visual_findings.json"
      ],
      "check_points": [
        "中文摘要页开始出现页眉与页码",
        "前置部分和正式部分的 section 设置分界清晰"
